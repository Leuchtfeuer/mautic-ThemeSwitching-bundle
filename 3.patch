From e2b6f52aa5bd626d6c20ff5ebdd2fc493dd1314d Mon Sep 17 00:00:00 2001
From: iuriJorbenadze <ijorb19@freeuni.edu.ge>
Date: Fri, 16 May 2025 19:08:50 +0400
Subject: [PATCH 1/5] feat: skip theme switching modal for HTML-based emails
 (mautic_code_mode)

- Introduced backend API endpoint at /plugin/theme-switch/email-type/{id} that returns the current email template name and whether it is using 'mautic_code_mode'
- Modified JavaScript override of Mautic.initSelectTheme:
  - Added call to new fetchEmailTemplate(emailId) helper
  - If isCodemode is true, default Mautic theme selection logic is triggered and modal is skipped
  - Otherwise, the custom modal is shown with Smart Merge, Translation Mode, and Mautic Default options
- Adjusted ThemeSwitchingController:
  - Injected MauticFactory for safe access to models and helpers without relying on deprecated container lookups
  - Added checkEmailTypeAction that returns the template name and a boolean indicating codemode status
  - Replaced $this->getModel and $this->get() with injected $factory->getModel(...) and $factory->getHelper(...)
- Updated services.yaml to inject mautic.factory into ThemeSwitchingController
- Removed EmailController override from services.yaml since it is no longer required
- Updated config.php to register the new public route with full class path for checkEmailTypeAction
- Improved robustness in ThemeSwitchingService by adding isMjmlContent utility method
- Prevented MJML merge logic from executing when either source or target template is not MJML, returning a fallback response instead
---
 Assets/js/theme-switch.js               | 40 +++++++++++++++++++-
 Config/config.php                       | 17 ++++++++-
 Controller/ThemeSwitchingController.php | 49 ++++++++++++++++++++-----
 Resources/config/services.yaml          | 28 +++++++-------
 Service/ThemeSwitchingService.php       |  7 ++++
 5 files changed, 114 insertions(+), 27 deletions(-)

diff --git a/Assets/js/theme-switch.js b/Assets/js/theme-switch.js
index 3417b7d..0750df4 100644
--- a/Assets/js/theme-switch.js
+++ b/Assets/js/theme-switch.js
@@ -28,8 +28,29 @@ Mautic.initSelectTheme = function(themeField) {
             return;
         }
 
-        // Show our custom modal dialog
-        showThemeSwitchModal(themeField, theme, $link);
+        // // Show our custom modal dialog
+        // showThemeSwitchModal(themeField, theme, $link);
+
+        const emailId = getEmailIdFromDomOrUrl();
+        if (!emailId) {
+            alert("Unable to determine email ID.");
+            return;
+        }
+
+        fetchEmailTemplate(emailId).then(response => {
+            if (response.isCodemode) {
+                // Fall back to Mautic default behavior
+                defaultInitSelectTheme(themeField);
+                $link.off('click.leuchtfeuerChoice').trigger('click');
+                return;
+            }
+
+            // Otherwise, show our custom modal
+            showThemeSwitchModal(themeField, theme, $link);
+        });
+
+
+
     });
 };
 
@@ -130,6 +151,21 @@ function getEmailIdFromDomOrUrl() {
     return null;
 }
 
+function fetchEmailTemplate(emailId) {
+    return fetch(`/plugin/theme-switch/email-type/${emailId}`)
+        .then(resp => {
+            if (!resp.ok) {
+                throw new Error(`Failed to fetch email info: HTTP ${resp.status}`);
+            }
+            return resp.json(); // return entire response, not just .template
+        })
+        .catch(err => {
+            console.error('[ThemeSwitch] Could not fetch template info:', err);
+            return { isCodemode: false, template: null }; // default fallback
+        });
+}
+
+
 
