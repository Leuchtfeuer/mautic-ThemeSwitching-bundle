{
    "name": "leuchtfeuer/mautic-themeswitching-bundle",
    "description": "Allows MJML Theme switching without losing all content by introducing markers.<br><br> Theme Switching for MJML works best if your themes include the proper markers. Docs: <a href=\"https://leuchtfeuer.com/mautic/know-how/theme-switching-plugin\" target=\"_blank\">Documentation</a>.",
    "type": "mautic-plugin",
    "license": "GPL-3.0",
    "authors": [
        {
            "name": "Leuchtfeuer Digital Marketing GmbH",
            "email": "mautic-plugins@Leuchtfeuer.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "mautic/core-lib": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\LeuchtfeuerThemeSwitchingBundle\\": ""
        }
    },
    "extra": {
        "install-directory-name": "LeuchtfeuerThemeSwitchingBundle"
    },
    "repositories": [
        {"type": "composer", "url": "https://packages.mautic.org"}
    ],
    "scripts": {
        "test": "phpunit"
    }
}
