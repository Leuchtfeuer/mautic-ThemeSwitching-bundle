  "type": "mautic-plugin",
  "license": "GPL-3.0",
  "authors": [
    {
      "name": "Leuchtfeuer Digital Marketing GmbH",
      "email": "mautic-plugins@Leuchtfeuer.com"
    }
  ],
  "extra": {
    "install-directory-name": "LeuchtfeuerThemeSwitchingBundle"
},
  "autoload": {
    "psr-4": {
      "MauticPlugin\\LeuchtfeuerThemeSwitchingBundle\\": ""
    }
  },
  "require-dev": {
    "phpunit/phpunit": "9.6"
  },
  "scripts": {
    "test": "phpunit"
  }
